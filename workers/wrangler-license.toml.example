name = "bynd-license"
main = "license/worker.mjs"
compatibility_date = "2026-09-30"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
# Copy to wrangler-license.toml, configure the database, then deliberately add
# routes. This template does not deploy or attach routes by itself.
# routes = [
#   { pattern = "bynd.ccwu.cc/license/v1/*", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/updates/v1/*", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/admin/v1/*", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/account/v1/*", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/distribution/v1/*", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/downloads/*", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/shop.html", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/checkout.html", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/account.html", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/license-admin.html", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/license-receipt.html", zone_name = "bynd.ccwu.cc" },
#   { pattern = "bynd.ccwu.cc/assets/website/*", zone_name = "bynd.ccwu.cc" }
# ]

[vars]
LICENSE_ACTIVATION_ENABLED = "false"
SALES_ENABLED = "false"
AFDIAN_ENABLED = "false"
# Configure only after reviewing the exact one-unit ¥13.88 plan; no secrets here.
# AFDIAN_USER_ID = "creator-id"
# AFDIAN_PLAN_ID = "plan-id"
# AFDIAN_PRODUCT_TYPE = "0" # 0 regular plan, 1 sale plan (also requires AFDIAN_SKU_ID)
# AFDIAN_SKU_ID = "sku-id"
# AFDIAN_PURCHASE_URL = "https://afdian.com/a/your-page"
# AFDIAN_CLIENT_ID = "official-oauth-client-id"
# Worker secrets: AFDIAN_API_TOKEN, AFDIAN_CLIENT_SECRET, AFDIAN_WEBHOOK_SECRET (random 32+ characters)
EMAIL_ENABLED = "false"
# Enable accounts only after configuring the verified email sender and ACCOUNT_SECRET.
ACCOUNTS_ENABLED = "false"
PUBLIC_ORIGIN = "https://bynd.ccwu.cc"
SIGNING_KEY_ID = "bynd-2026-01"
APK_ALLOWED_HOSTS = "bynd.ccwu.cc"
# Pin the real release certificate SHA-256 before uploading APKs.
APK_SIGNER_SHA256 = ""
# EMAIL_FROM = "BYND <license@your-verified-domain>"

[assets]
directory = "../.bynd-distribution-web"
binding = "ASSETS"
run_worker_first = true
html_handling = "none"

[triggers]
crons = ["*/5 * * * *"]

[[ratelimits]]
name = "PAYMENT_RATE_LIMITER"
namespace_id = "1004"
simple = { limit = 30, period = 60 }

[[d1_databases]]
binding = "DB"
database_name = "bynd-license"
database_id = "REPLACE_WITH_D1_ID"
migrations_dir = "license/migrations"

[[ratelimits]]
name = "ACTIVATION_RATE_LIMITER"
namespace_id = "1001"
simple = { limit = 10, period = 60 }

[[ratelimits]]
name = "RECEIPT_RATE_LIMITER"
namespace_id = "1002"
simple = { limit = 10, period = 60 }

[[r2_buckets]]
binding = "APK_BUCKET"
bucket_name = "bynd-apks"

[[ratelimits]]
name = "ACCOUNT_RATE_LIMITER"
namespace_id = "1003"
simple = { limit = 10, period = 60 }

# scrypt login hashing requires a Workers plan with enough CPU; benchmark before launch.
[limits]
cpu_ms = 1000

# Secrets: ADMIN_TOKEN, LICENSE_KEY_SECRET, SIGNING_PRIVATE_JWK, ACCOUNT_SECRET
# Optional email secret: RESEND_API_KEY (EMAIL_ENABLED stays false until configured)
# Keep LICENSE_KEY_SECRET stable: it derives recoverable, idempotent codes.
